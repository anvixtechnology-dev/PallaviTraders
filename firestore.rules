rules_version = '2';

/**
 * PALLAVI IRON TRADERS — Firestore rules
 *
 * Stock, customer aggregates, sales and quotations are private business
 * records, so every read and write requires a signed-in admin account.
 *
 * Collections:
 *   stock       — one document per item (maintained in the Firebase console)
 *   customers   {normalisedName} -> running aggregate per customer
 *   sales       one document per recorded sale
 *   quotations  saved quotations (never affect stock)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /stock/{stockItemId} {
      allow read, write: if isSignedIn();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    match /sales/{saleId} {
      allow read, write: if isSignedIn();
    }

    match /quotations/{quotationId} {
      allow read, write: if isSignedIn();
    }

    // Anything not listed above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}