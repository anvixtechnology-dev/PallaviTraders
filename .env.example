# Copy this file to `.env.local` and fill in the values from
# Firebase console → Project settings → Your apps → SDK setup and configuration.
#
# The app already falls back to the project's web configuration, so this file is
# only needed when you want to override the config (for example to point the
# build at a staging project). All of these values are public web keys — they are
# safe to ship in a browser bundle; access is protected by Firestore rules and
# Firebase Authentication, not by hiding this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional. Google Analytics only starts in a secure context (HTTPS or localhost).
# Set to false to keep it switched off entirely; it is off when unset.
VITE_ENABLE_ANALYTICS=